{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {"mode": "token"},
    "controlUi": {"enabled": false}
  },
  "update": {"checkOnStart": false},
  "cron": {"enabled": false},
  "tools": {"elevated": {"enabled": false}},
  "env": {
    "vars": {
      "ANTHROPIC_BASE_URL": "http://mock-model.test-support.svc.cluster.local:8000/env-vars",
      "CLAUDE_CONFIG_DIR": "/home/node/.openclaw/claude",
      "TNWKS_ENV_VARS_MARKER": "present"
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "systemAgent": {"agentId": "main"},
      "heartbeat": {"agentId": "main"},
      "model": {"primary": "anthropic/claude-opus-4-6"},
      "modelPolicy": {"allow": ["anthropic/claude-opus-4-6"]},
      "models": {
        "anthropic/claude-opus-4-6": {"agentRuntime": {"id": "claude-cli"}}
      },
      "sandbox": {"mode": "all", "backend": "openshell", "scope": "session", "workspaceAccess": "rw"}
    },
    "entries": {
      "main": {"workspace": "~/.openclaw/workspace"},
      "wide": {"workspace": "~/.openclaw/workspace-wide"},
      "sbexec": {
        "workspace": "~/.openclaw/workspace-sbexec",
        "tools": {"exec": {"host": "sandbox"}}
      },
      "gwexec": {
        "workspace": "~/.openclaw/workspace-gwexec",
        "tools": {"exec": {"mode": "full"}}
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/openclaw/plugins/node_modules/@openclaw/openshell-sandbox",
        "/opt/openclaw/plugins/node_modules/@openclaw/signal"
      ]
    },
    "entries": {
      "anthropic": {
        "enabled": true,
        "config": {
          "managedNativeTools": {
            "default": [],
            "agents": {"wide": ["Agent", "Workflow"], "gwexec": ["Agent", "Workflow"]}
          }
        }
      },
      "openshell": {
        "enabled": true,
        "config": {
          "mode": "mirror",
          "from": "${OPENSHELL_SANDBOX_FROM}",
          "gatewayEndpoint": "https://openshell.openshell.svc.cluster.local:8080",
          "timeoutSeconds": 300
        }
      }
    }
  }
}
