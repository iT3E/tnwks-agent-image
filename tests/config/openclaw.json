{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {"mode": "token"},
    "controlUi": {"enabled": false}
  },
  "update": {"checkOnStart": false},
  "cron": {"enabled": false},
  "tools": {
    "elevated": {"enabled": false},
    "deny": ["code_execution", "file_fetch", "file_write", "dir_list", "dir_fetch"],
    "sandbox": {"tools": {"alsoAllow": ["web_search"]}},
    "web": {"search": {"enabled": true, "provider": "brave"}}
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "model": {"primary": "mock/claude-opus-4-6"},
      "sandbox": {"mode": "all", "backend": "openshell", "scope": "session", "workspaceAccess": "rw"}
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "mock": {
        "baseUrl": "http://mock-model.test-support.svc.cluster.local:8000",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "claude-opus-4-6",
            "name": "mock model",
            "reasoning": true,
            "input": ["text"],
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
            "contextWindow": 200000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/openclaw/plugins/node_modules/@openclaw/openshell-sandbox",
        "/opt/openclaw/plugins/node_modules/@openclaw/signal",
        "/opt/openclaw/plugins/node_modules/@openclaw/brave-plugin"
      ]
    },
    "entries": {
      "openshell": {
        "enabled": true,
        "config": {
          "mode": "mirror",
          "from": "${OPENSHELL_SANDBOX_FROM}",
          "gatewayEndpoint": "https://openshell.openshell.svc.cluster.local:8080",
          "timeoutSeconds": 300
        }
      },
      "brave": {
        "enabled": true,
        "config": {"webSearch": {"baseUrl": "http://127.0.0.1:18790"}}
      },
      "diagnostics-otel": {"enabled": true}
    }
  },
  "diagnostics": {
    "otel": {
      "enabled": true,
      "endpoint": "http://otelcol.test-support.svc.cluster.local:4318",
      "protocol": "http/protobuf",
      "serviceName": "tnwks-agent-image-test",
      "traces": true,
      "metrics": false,
      "logs": false,
      "sampleRate": 1.0
    }
  }
}
